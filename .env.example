# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldur.
# `.env.local` .gitignore'da — gerçek değerler ASLA commit edilmez.

# --- Formlar (iletişim + üyelik başvurusu) -----------------------------------
# Gönderimlerin gittiği Google Apps Script Web App adresi.
# Nasıl alınır: google-apps-script/README.md
FORM_ENDPOINT_URL=

# Apps Script'teki `FORM_SHARED_SECRET` script özelliğiyle birebir aynı olmalı.
# Uç noktayı, URL'i ele geçiren birinin tabloya kayıt atmasına karşı korur.
FORM_SHARED_SECRET=

# İkisi de boşsa formlar "şu an devre dışı" hatası verir (sessizce kaybolmaz).

# --- Form güvenliği (Cloudflare Turnstile) -----------------------------------
# Ücretsiz ve limitsiz bot doğrulaması; çerez kullanmaz, çoğu ziyaretçiye
# bulmaca göstermez. İKİSİ DE BOŞKEN KORUMA KAPALIDIR: formlar çalışmaya devam
# eder, honeypot + zaman tuzağı + hız sınırı her hâlükârda devrededir. Anahtar
# eklenince formun altında görünür bir doğrulama kutusu ve "Cloudflare Turnstile
# ile korunuyor" satırı çıkar.
#
# Nasıl alınır: dash.cloudflare.com → Turnstile → Add widget
#   - Widget mode: Managed
#   - Hostnames: ytublockchain.com (yerelde denemek için + localhost)
# Site key GİZLİ DEĞİL (istemci paketine gömülür), secret key gizlidir.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Site --------------------------------------------------------------------
# Kanonik/OG/sitemap taban adresi. Tanımsızsa src/lib/site.ts'teki değer geçerli.
NEXT_PUBLIC_SITE_URL=

# Tailark Pro registry token — yalnızca `shadcn` ile bileşen çekerken gerekir.
TAILARK_API_KEY=

# --- Blog (Sanity) -----------------------------------------------------------
# Bu iki değer GİZLİ DEĞİL: Studio tarayıcıda çalıştığı için ikisi de istemci
# paketine gömülüyor. Bu yüzden zorunlu değiller — tanımsız bırakılırsa
# src/sanity/env.ts'teki değerler geçerli olur (kulübün gerçek projesi).
# Burayı yalnızca başka bir projeye ya da test dataset'ine bağlanmak için doldur.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sanity webhook'unun imza gizi — Sanity yönetim panelindeki webhook'un
# "Secret" alanıyla BİREBİR aynı olmalı. Yazı yayınlandığında sitenin
# tazelenmesini sağlayan /api/revalidate ucunu, uç adresini ele geçiren birinin
# tetiklemesine karşı korur. Tanımsızsa uç 500 döner (sessizce "başarılı"
# dönmez, yoksa webhook Sanity tarafında yeşil görünüp site hiç tazelenmezdi).
SANITY_REVALIDATE_SECRET=

# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldur.
# `.env.local` .gitignore'da — gerçek değerler ASLA commit edilmez.

# --- Formlar (iletişim + üyelik başvurusu) -----------------------------------
# Gönderimlerin gittiği Google Apps Script Web App adresi.
# Nasıl alınır: google-apps-script/README.md
FORM_ENDPOINT_URL=

# Apps Script'teki `FORM_SHARED_SECRET` script özelliğiyle birebir aynı olmalı.
# Uç noktayı, URL'i ele geçiren birinin tabloya kayıt atmasına karşı korur.
FORM_SHARED_SECRET=

# İkisi de boşsa formlar "şu an devre dışı" hatası verir (sessizce kaybolmaz).

# --- Site --------------------------------------------------------------------
# Kanonik/OG/sitemap taban adresi. Tanımsızsa src/lib/site.ts'teki değer geçerli.
NEXT_PUBLIC_SITE_URL=

# Tailark Pro registry token — yalnızca `shadcn` ile bileşen çekerken gerekir.
TAILARK_API_KEY=

# --- Blog (Sanity) -----------------------------------------------------------
# Bu iki değer GİZLİ DEĞİL: Studio tarayıcıda çalıştığı için ikisi de istemci
# paketine gömülüyor. Bu yüzden zorunlu değiller — tanımsız bırakılırsa
# src/sanity/env.ts'teki değerler geçerli olur (kulübün gerçek projesi).
# Burayı yalnızca başka bir projeye ya da test dataset'ine bağlanmak için doldur.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

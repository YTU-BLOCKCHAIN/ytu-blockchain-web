{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ana sayfada öne çıkan X paylaşımları",
  "type": "object",
  "required": ["posts"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "posts": {
      "type": "array",
      "description": "Öne çıkarılacak X paylaşımlarının adresleri. Sıralama buradaki sıradır; 3 tane önerilir. Metin, tarih ve yazar otomatik çekilir.",
      "items": {
        "type": "string",
        "pattern": "^https://(x|twitter)\\.com/[A-Za-z0-9_]{1,15}/status/[0-9]+",
        "description": "Örnek: https://x.com/BlockchainYtu/status/1234567890123456789"
      }
    }
  }
}
